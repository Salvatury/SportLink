@model SportLink.Entidades.Partido

<h2 class="mt-4">Eliminar Partido</h2>

<hr />

<div class="alert alert-warning">
    ¿Estás seguro de que querés eliminar este partido?
</div>

<div class="mb-3">
    <label class="form-label"><strong>Fecha y hora:</strong></label>
    <div>@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</div>
</div>

<div class="mb-3">
    <label class="form-label"><strong>Estado:</strong></label>
    <div>@Model.Estado</div>
</div>

<div class="mb-3">
    <label class="form-label"><strong>Observaciones:</strong></label>
    <div>@Model.Observaciones</div>
</div>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="PartidoId" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>