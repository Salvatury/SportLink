@model List<SportLink.Entidades.Categoria>

<div class="row justify-content-between mt-4">
    <div class="col-6">
        <h2>Categorías</h2>
    </div>
    <div class="col-6 text-end">
        <a asp-controller="Categoria" asp-action="Crear" class="btn btn-success">Crear</a>
    </div>
</div>

<hr />

@if (Model != null && Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Activa</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>
                    <td>@(categoria.Activa ? "Sí" : "No")</td>
                    <td>
                        <a asp-controller="Categoria" asp-action="Editar" asp-route-id="@categoria.CategoriaId" class="btn btn-sm btn-primary">Editar</a>
                        <a asp-controller="Categoria" asp-action="Eliminar" asp-route-id="@categoria.CategoriaId" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No hay categorías cargadas.
    </div>
}