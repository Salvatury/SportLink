@model SportLink.Entidades.Resultado

<h2 class="mt-4">Eliminar Resultado</h2>

<hr />

<div class="alert alert-warning">
    ¿Estás seguro de que querés eliminar este resultado?
</div>

<div class="mb-3">
    <label class="form-label"><strong>Goles Local:</strong></label>
    <div>@Model.GolesLocal</div>
</div>

<div class="mb-3">
    <label class="form-label"><strong>Goles Visitante:</strong></label>
    <div>@Model.GolesVisitante</div>
</div>

<div class="mb-3">
    <label class="form-label"><strong>Observaciones:</strong></label>
    <div>@Model.Observaciones</div>
</div>

<div class="mb-3">
    <label class="form-label"><strong>Fecha de carga:</strong></label>
    <div>@Model.FechaCarga.ToString("dd/MM/yyyy HH:mm")</div>
</div>

@* TODO: más adelante mostrar también los datos relacionados del partido y del usuario *@

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="ResultadoId" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>